# Copy to `.env` for local runs. Never commit a real key.
# The plugin does NOT read these variables implicitly: live access requires an
# explicit `provider: live` plus an explicit `apiKey` in the plugin config.
TYPESAFE_API_KEY=replace-with-your-key
# Optional overrides honoured only when passed through plugin config:
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
