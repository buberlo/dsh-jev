{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src/client",
    "outDir": "lib/types/client",
    "declarationDir": "lib/types/client",
    "emitDeclarationOnly": true,
    "declaration": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "types": []
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx"]
}
